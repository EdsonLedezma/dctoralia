generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  phone         String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(PATIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                   Account[]
  sessions                   Session[]
  doctor                     Doctor?
  patient                    Patient?
  clinicMemberships          ClinicMember[]
  clinicInvitations          ClinicInvitation[]           @relation("ClinicInvitations")
  createdCareEpisodes        CareEpisode[]                @relation("CareEpisodeCreator")
  authoredEncounters         ClinicalEncounter[]          @relation("ClinicalEncounterAuthor")
  assignedFollowUpTasks      FollowUpTask[]               @relation("FollowUpAssignee")
  createdFollowUpTasks       FollowUpTask[]               @relation("FollowUpCreator")
  completedFollowUpTasks     FollowUpTask[]               @relation("FollowUpCompleter")
  recordedOutcomeAssessments OutcomeAssessment[]          @relation("OutcomeRecorder")
  clinicalAuditEvents        ClinicalAuditEvent[]         @relation("ClinicalAuditActor")
  authoredClinicalAmendments ClinicalEncounterAmendment[] @relation("ClinicalAmendmentAuthor")
  appointmentLifecycleEvents AppointmentLifecycleEvent[]  @relation("AppointmentLifecycleActor")
  addedClinicPatients        ClinicPatient[]              @relation("ClinicPatientAdder")
}

/// Tenant boundary for a medical practice. Links on current operational
/// models are optional until the owner runs the reviewed backfill migration.
model Clinic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("America/Mexico_City")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations                   ClinicLocation[]
  members                     ClinicMember[]
  invitations                 ClinicInvitation[]
  subscription                ClinicSubscription?
  doctors                     Doctor[]                     @relation("ClinicDoctors")
  patients                    Patient[]                    @relation("ClinicPatients")
  services                    Service[]                    @relation("ClinicServices")
  appointments                Appointment[]                @relation("ClinicAppointments")
  schedules                   Schedule[]                   @relation("ClinicSchedules")
  reviews                     Review[]                     @relation("ClinicReviews")
  notifications               Notification[]               @relation("ClinicNotifications")
  messageOutbox               MessageOutbox[]
  messageInbox                MessageInbox[]
  careEpisodes                CareEpisode[]
  encounters                  ClinicalEncounter[]
  followUpTasks               FollowUpTask[]
  outcomeAssessments          OutcomeAssessment[]
  clinicalAuditEvents         ClinicalAuditEvent[]
  clinicalEncounterAmendments ClinicalEncounterAmendment[]
  appointmentLifecycleEvents  AppointmentLifecycleEvent[]
  patientMemberships          ClinicPatient[]
}

model ClinicLocation {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  address   String?
  timezone  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[] @relation("LocationAppointments")

  @@index([clinicId, isActive])
}

model ClinicMember {
  id        String           @id @default(cuid())
  clinicId  String
  userId    String
  role      ClinicMemberRole @default(DOCTOR)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
  @@index([userId])
}

model ClinicInvitation {
  id              String           @id @default(cuid())
  clinicId        String
  invitedByUserId String
  email           String
  role            ClinicMemberRole @default(DOCTOR)
  tokenHash       String           @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  clinic        Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invitedByUser User   @relation("ClinicInvitations", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([clinicId, email])
  @@index([clinicId, expiresAt])
}

model ClinicSubscription {
  id                       String             @id @default(cuid())
  clinicId                 String             @unique
  plan                     SubscriptionPlan   @default(PRO)
  status                   SubscriptionStatus @default(PAUSED)
  currency                 String             @default("MXN")
  monthlyPriceMxn          Int?
  includedMessagingMxn     Int?
  messagingOverageAllowed  Boolean            @default(false)
  customDevelopmentEnabled Boolean            @default(false)
  extendedMessagingEnabled Boolean            @default(false)
  provider                 String?
  providerCustomerId       String?
  providerSubscriptionId   String?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean            @default(false)
  checkoutSessionId        String?
  checkoutAttempt          Int                @default(0)
  billingLockToken         String?
  billingLockUntil         DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  clinic       Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  usagePeriods SubscriptionUsagePeriod[]

  @@index([plan, status])
  @@index([providerSubscriptionId])
}

model SubscriptionUsagePeriod {
  id                   String   @id @default(cuid())
  clinicSubscriptionId String
  periodStart          DateTime
  periodEnd            DateTime
  messagingUsedMxn     Int      @default(0)
  messagingOverageMxn  Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscription ClinicSubscription @relation(fields: [clinicSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([clinicSubscriptionId, periodStart])
  @@index([periodEnd])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       String // EMAIL_VERIFICATION, PHONE_VERIFICATION, PASSWORD_RECOVERY

  @@unique([identifier, token])
}

model Doctor {
  id           String   @id @default(cuid())
  userId       String   @unique
  specialty    String
  license      String   @unique
  phone        String
  about        String?
  experience   Int? // años de experiencia
  rating       Float? // promedio de calificaciones
  totalReviews Int? // total de reseñas
  clinicId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic                     Clinic?                     @relation("ClinicDoctors", fields: [clinicId], references: [id], onDelete: SetNull)
  appointments               Appointment[]               @relation("DoctorAppointments")
  services                   Service[]                   @relation("DoctorServices")
  schedules                  Schedule[]
  reviews                    Review[]                    @relation("DoctorReviews")
  notifications              Notification[]              @relation("DoctorNotifications")
  careEpisodes               CareEpisode[]
  encounters                 ClinicalEncounter[]
  appointmentLifecycleEvents AppointmentLifecycleEvent[]

  @@index([clinicId])
}

model Patient {
  id        String    @id @default(cuid())
  userId    String    @unique
  phone     String
  birthDate DateTime?
  gender    String?
  address   String?
  clinicId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic                     Clinic?                     @relation("ClinicPatients", fields: [clinicId], references: [id], onDelete: SetNull)
  appointments               Appointment[]               @relation("PatientAppointments")
  reviews                    Review[]                    @relation("PatientReviews")
  medicalHistory             MedicalHistory?
  notifications              Notification[]              @relation("PatientNotifications")
  careEpisodes               CareEpisode[]
  encounters                 ClinicalEncounter[]
  followUpTasks              FollowUpTask[]
  outcomeAssessments         OutcomeAssessment[]
  clinicalAuditEvents        ClinicalAuditEvent[]
  appointmentLifecycleEvents AppointmentLifecycleEvent[]
  clinicMemberships          ClinicPatient[]

  @@index([clinicId])
}

/// Explicit membership of a patient identity in a practice. A patient can
/// receive care at multiple clinics without sharing one clinic's chart.
model ClinicPatient {
  id            String              @id @default(cuid())
  clinicId      String
  patientId     String
  addedByUserId String
  status        ClinicPatientStatus @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  addedBy User    @relation("ClinicPatientAdder", fields: [addedByUserId], references: [id], onDelete: Restrict)

  @@unique([clinicId, patientId])
  @@index([clinicId, status, updatedAt])
  @@index([patientId, status])
}

model Service {
  id          String   @id @default(cuid())
  doctorId    String
  name        String
  description String
  price       Float
  duration    Int // en minutos
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinicId    String?

  doctor       Doctor        @relation("DoctorServices", fields: [doctorId], references: [id], onDelete: Cascade)
  clinic       Clinic?       @relation("ClinicServices", fields: [clinicId], references: [id], onDelete: SetNull)
  appointments Appointment[] @relation("ServiceAppointments")

  @@index([clinicId, isActive])
}

model Appointment {
  id         String               @id @default(cuid())
  doctorId   String
  patientId  String
  serviceId  String
  date       DateTime
  time       String
  duration   Int // en minutos
  status     AppointmentStatus    @default(PENDING)
  // Severidad percibida de la consulta/cita. Se utilizará para el algoritmo de card de salud.
  severity   AppointmentSeverity?
  notes      String?
  reason     String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  clinicId   String?
  locationId String?

  doctor            Doctor                      @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  patient           Patient                     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  service           Service                     @relation("ServiceAppointments", fields: [serviceId], references: [id], onDelete: Cascade)
  clinic            Clinic?                     @relation("ClinicAppointments", fields: [clinicId], references: [id], onDelete: SetNull)
  location          ClinicLocation?             @relation("LocationAppointments", fields: [locationId], references: [id], onDelete: SetNull)
  clinicalEncounter ClinicalEncounter?
  lifecycleEvents   AppointmentLifecycleEvent[]

  @@index([clinicId, date, status])
  @@index([locationId, date])
}

model Schedule {
  id        String   @id @default(cuid())
  doctorId  String
  dayOfWeek Int // 0 = Domingo, 1 = Lunes, etc.
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinicId  String?

  doctor Doctor  @relation(fields: [doctorId], references: [id])
  clinic Clinic? @relation("ClinicSchedules", fields: [clinicId], references: [id], onDelete: SetNull)

  @@unique([doctorId, dayOfWeek])
  @@index([clinicId, isActive])
}

model Review {
  id        String   @id @default(cuid())
  doctorId  String
  patientId String
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinicId  String?

  doctor  Doctor  @relation("DoctorReviews", fields: [doctorId], references: [id])
  patient Patient @relation("PatientReviews", fields: [patientId], references: [id])
  clinic  Clinic? @relation("ClinicReviews", fields: [clinicId], references: [id], onDelete: SetNull)

  @@unique([doctorId, patientId])
  @@index([clinicId, doctorId])
}

enum Role {
  DOCTOR
  PATIENT
  ADMIN
}

enum ClinicMemberRole {
  OWNER
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum SubscriptionPlan {
  PRO
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentLifecycleEventType {
  CREATED
  STATUS_CHANGED
  RESCHEDULED
}

enum ClinicPatientStatus {
  ACTIVE
  ARCHIVED
}

enum CareEpisodeStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ClinicalEncounterStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum FollowUpTaskType {
  FOLLOW_UP_APPOINTMENT
  REVIEW_RESULT
  PATIENT_CHECK_IN
  ADMINISTRATIVE
  OTHER
}

enum FollowUpTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FollowUpTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Severidad declarada/estimada de la cita
enum AppointmentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Estado de salud agregado a historial médico; la lógica de cálculo vendrá después
enum HealthStatus {
  HEALTHY // saludable
  LOW_IMMUNITY // defensas bajas
  SICK_LOW_RISK // enfermo con bajo riesgo
  SICK_HIGH_RISK // enfermo alto riesgo
}

// Tipo de sangre opcional
enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

// Historial médico principal por paciente
model MedicalHistory {
  id                String       @id @default(cuid())
  patientId         String       @unique
  bloodType         BloodType?
  allergies         String[] // lista de alergias
  medications       String[] // medicamentos actuales
  chronicDiseases   String[] // padecimientos crónicos
  surgeries         String[] // cirugías previas
  immunizations     String[] // vacunas
  healthStatus      HealthStatus @default(HEALTHY)
  height            String?
  weight            String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  insuranceProvider String?
  insuranceNumber   String?
  notes             String?
  lastUpdated       DateTime     @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

/// Longitudinal clinical pathway for a patient within one clinic.
model CareEpisode {
  id              String            @id @default(cuid())
  clinicId        String
  patientId       String
  primaryDoctorId String
  createdByUserId String
  title           String
  status          CareEpisodeStatus @default(ACTIVE)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  clinic        Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  primaryDoctor Doctor              @relation(fields: [primaryDoctorId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("CareEpisodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  encounters    ClinicalEncounter[]
  followUpTasks FollowUpTask[]
  assessments   OutcomeAssessment[]

  @@index([clinicId, patientId, status, updatedAt])
  @@index([clinicId, primaryDoctorId, status, updatedAt])
}

/// A provider-authored record for one clinical interaction. Signed encounters
/// are immutable through application use cases; corrections use amendments.
model ClinicalEncounter {
  id               String                  @id @default(cuid())
  clinicId         String
  patientId        String
  doctorId         String
  appointmentId    String?                 @unique
  episodeId        String?
  authoredByUserId String
  status           ClinicalEncounterStatus @default(DRAFT)
  encounterAt      DateTime                @default(now())
  chiefComplaint   String?                 @db.Text
  subjective       String?                 @db.Text
  objective        String?                 @db.Text
  assessment       String?                 @db.Text
  plan             String?                 @db.Text
  signedAt         DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  clinic        Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient       Patient                      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor        Doctor                       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment   Appointment?                 @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  episode       CareEpisode?                 @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  authoredBy    User                         @relation("ClinicalEncounterAuthor", fields: [authoredByUserId], references: [id], onDelete: Restrict)
  amendments    ClinicalEncounterAmendment[]
  followUpTasks FollowUpTask[]
  assessments   OutcomeAssessment[]

  @@index([clinicId, patientId, encounterAt(sort: Desc)])
  @@index([clinicId, doctorId, encounterAt(sort: Desc)])
  @@index([clinicId, episodeId, encounterAt(sort: Desc)])
}

/// Append-only correction attached to a signed encounter.
model ClinicalEncounterAmendment {
  id               String   @id @default(cuid())
  clinicId         String
  encounterId      String
  authoredByUserId String
  reason           String   @db.Text
  changes          Json
  createdAt        DateTime @default(now())

  encounter  ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  clinic     Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  authoredBy User              @relation("ClinicalAmendmentAuthor", fields: [authoredByUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, encounterId, createdAt])
}

/// Operational work that keeps a care plan moving between consultations.
model FollowUpTask {
  id                String               @id @default(cuid())
  clinicId          String
  patientId         String
  episodeId         String?
  encounterId       String?
  assignedToUserId  String?
  createdByUserId   String
  completedByUserId String?
  title             String
  details           String?              @db.Text
  type              FollowUpTaskType     @default(OTHER)
  priority          FollowUpTaskPriority @default(NORMAL)
  status            FollowUpTaskStatus   @default(OPEN)
  dueAt             DateTime?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  clinic      Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  episode     CareEpisode?       @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  encounter   ClinicalEncounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  assignedTo  User?              @relation("FollowUpAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy   User               @relation("FollowUpCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  completedBy User?              @relation("FollowUpCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, status, dueAt])
  @@index([clinicId, assignedToUserId, status, dueAt])
  @@index([clinicId, patientId, createdAt(sort: Desc)])
}

/// Versioned instrument result. Raw answers and numeric score are retained so
/// analytics can state which instrument and version produced each comparison.
model OutcomeAssessment {
  id                 String   @id @default(cuid())
  clinicId           String
  patientId          String
  episodeId          String?
  encounterId        String?
  recordedByUserId   String
  instrumentCode     String
  instrumentVersion  String
  score              Decimal? @db.Decimal(10, 3)
  scoreMin           Decimal? @db.Decimal(10, 3)
  scoreMax           Decimal? @db.Decimal(10, 3)
  responses          Json
  completedItemCount Int?
  totalItemCount     Int?
  measuredAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  clinic     Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient    Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  episode    CareEpisode?       @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  encounter  ClinicalEncounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  recordedBy User               @relation("OutcomeRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([clinicId, patientId, instrumentCode, instrumentVersion, measuredAt])
  @@index([clinicId, episodeId, measuredAt])
}

/// Audit metadata only: never duplicate free-text clinical notes here.
model ClinicalAuditEvent {
  id           String   @id @default(cuid())
  clinicId     String
  patientId    String?
  actorUserId  String?
  resourceType String
  resourceId   String
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  actor   User?    @relation("ClinicalAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, createdAt(sort: Desc)])
  @@index([clinicId, resourceType, resourceId, createdAt])
  @@index([clinicId, actorUserId, createdAt(sort: Desc)])
}

/// Immutable operational events used to explain appointment analytics over time.
model AppointmentLifecycleEvent {
  id            String                        @id @default(cuid())
  clinicId      String?
  appointmentId String?
  patientId     String?
  doctorId      String?
  actorUserId   String?
  eventType     AppointmentLifecycleEventType
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  scheduledAt   DateTime?
  scheduledTime String?
  metadata      Json?
  occurredAt    DateTime                      @default(now())

  clinic      Clinic?      @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  doctor      Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  actor       User?        @relation("AppointmentLifecycleActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, occurredAt, eventType])
  @@index([clinicId, doctorId, occurredAt])
  @@index([appointmentId, occurredAt])
}

// Notificaciones para eventos de citas
model Notification {
  id            String           @id @default(cuid())
  doctorId      String
  patientId     String
  type          NotificationType
  title         String
  message       String
  appointmentId String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  clinicId      String?

  doctor  Doctor  @relation("DoctorNotifications", fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation("PatientNotifications", fields: [patientId], references: [id], onDelete: Cascade)
  clinic  Clinic? @relation("ClinicNotifications", fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
}

/// Durable outbound messages. Rows are created in the same transaction as the
/// domain event and claimed by a dispatcher with an idempotency key.
model MessageOutbox {
  id                String                @id @default(cuid())
  clinicId          String?
  provider          String                @default("sent")
  channel           MessageChannel
  recipient         String
  template          String
  payload           Json
  idempotencyKey    String                @unique
  correlationId     String?
  providerMessageId String?               @unique
  leaseToken        String?
  leaseUntil        DateTime?
  sandbox           Boolean               @default(true)
  status            MessageDeliveryStatus @default(PENDING)
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime              @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  lastErrorCode     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([clinicId, createdAt])
}

model BillingWebhookEvent {
  id          String   @id
  eventType   String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Deduplicated inbound provider events. The unique provider/event pair makes
/// webhook retries safe before any automation mutates the domain.
model MessageInbox {
  id                String    @id @default(cuid())
  clinicId          String?
  provider          String
  externalEventId   String
  eventType         String?
  payload           Json
  signatureVerified Boolean   @default(false)
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([clinicId, createdAt])
}

enum MessageChannel {
  SMS
  WHATSAPP
  RCS
}

enum MessageDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULE_REQUEST
  APPOINTMENT_RESCHEDULED
}
