# Dopilot / Dctoralia — variables necesarias para Vercel
#
# Copia este archivo como .env.local para desarrollo.
# En Vercel agrega las mismas variables en Project Settings > Environment Variables.
# Nunca subas valores reales ni secretos al repositorio.

# -----------------------------------------------------------------------------
# Autenticación — obligatoria en producción
# -----------------------------------------------------------------------------
# Genera un valor seguro con: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# -----------------------------------------------------------------------------
# PostgreSQL / Prisma — obligatorias
# -----------------------------------------------------------------------------
# URL principal. En Vercel/Neon normalmente es la URL pooled.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# URL pooled usada por Prisma Client en runtime.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/DATABASE?sslmode=require&pgbouncer=true"

# URL directa usada para operaciones administrativas/generación de Prisma.
# No la expongas al cliente.
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# -----------------------------------------------------------------------------
# Variables locales opcionales
# -----------------------------------------------------------------------------
# Vercel define NODE_ENV y VERCEL_URL automáticamente.
# NODE_ENV="development"
# PORT="3000"

# SKIP_ENV_VALIDATION="true"  # Sólo para builds especiales; evitar en producción.

# -----------------------------------------------------------------------------
# Stripe — servidor únicamente. Empieza con claves y precios de TEST.
# -----------------------------------------------------------------------------
# URL canónica; no se deriva de headers enviados por el navegador.
APP_URL="http://localhost:3000"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Pro: precio recurrente mensual, MXN, 80000 centavos, quantity 1.
STRIPE_PRICE_PRO=""
# Enterprise/Custom: precios mensuales MXN de tu contrato. No hay precio inventado.
STRIPE_PRICE_ENTERPRISE=""
STRIPE_PRICE_CUSTOM=""
# Webhook: POST /api/integrations/stripe/webhook
# Eventos: customer.subscription.created / updated / deleted
# Portal Stripe: habilita métodos de pago, facturas y cancelación.
# No habilites cambios de plan/cantidad en el portal hasta validar límites de downgrade.

# -----------------------------------------------------------------------------
# Sent — plantilla pendiente: mantener desactivado y en sandbox.
# -----------------------------------------------------------------------------
SENT_ENABLED="false"
SENT_SANDBOX="true"
SENT_API_KEY=""
# Sólo para claves de organización; UUID del perfil hijo. Opcional con clave de perfil.
SENT_PROFILE_ID=""
SENT_WEBHOOK_SECRET=""
# Nombre EXACTO de plantilla de prueba; debe aceptar el parámetro de texto "name".
SENT_TEST_TEMPLATE=""
# Webhook: POST /api/integrations/sent/webhook
# El botón de prueba en Workspace siempre crea mensajes sandbox al teléfono propio.

# Secreto aleatorio de al menos 32 caracteres para GET /api/cron/messages.
# El scheduler debe enviar Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""

# Las recetas a pacientes y el cargo automático de excedentes NO están activados.
# Vapi sigue fuera del runtime. No se necesita VAPI_API_KEY.
# Guía completa: docs/INTEGRACIONES.md
